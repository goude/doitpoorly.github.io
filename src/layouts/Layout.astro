---
import "../styles/global.css";
import { execSync } from "node:child_process";

interface Props {
  title?: string;
  current?: string;
  /** Extra class on <main>. "post" switches on the text + margin-note grid. */
  mainClass?: string;
}

const { title, current = "", mainClass } = Astro.props;
const fullTitle = title ? `${title} · doitpoorly` : "doitpoorly";

// Patch = commit count, so it's structurally guaranteed to bump on every
// build that includes a new commit (CI needs a full clone, not a shallow
// one, for this to be meaningful -- see astro.yml's checkout step).
function siteVersion(): string {
  try {
    const count = execSync("git rev-list --count HEAD").toString().trim();
    const sha = execSync("git rev-parse --short HEAD").toString().trim();
    return `0.0.${count} (${sha})`;
  } catch {
    return "dev";
  }
}
const version = siteVersion();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header>
      <div>
        <a class="site-title" href="/">doitpoorly</a>
        <p>A build log for 3D printed projects done poorly, on purpose.</p>
      </div>
      <nav>
        <a href="/" aria-current={current === "home" ? "page" : undefined}
          >Home</a
        >
        <a
          href="/builds"
          aria-current={current === "builds" ? "page" : undefined}>Builds</a
        >
        <a href="/about" aria-current={current === "about" ? "page" : undefined}
          >About</a
        >
      </nav>
    </header>
    <main class={mainClass}>
      <slot />
    </main>
    <footer>
      <span>&copy; doitpoorly</span>
      <span class="site-version">v{version}</span>
    </footer>
  </body>
</html>
