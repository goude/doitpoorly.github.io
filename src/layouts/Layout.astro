---
import "../styles/global.css";

interface Props {
  title?: string;
  current?: string;
}

const { title, current = "" } = Astro.props;
const fullTitle = title ? `${title} · doitpoorly` : "doitpoorly";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header>
      <h1>doitpoorly</h1>
      <p>A build log for 3D printed projects done poorly, on purpose.</p>
    </header>
    <nav>
      <a href="/" aria-current={current === "home" ? "page" : undefined}
        >Home</a
      >
      <a
        href="/builds"
        aria-current={current === "builds" ? "page" : undefined}>Builds</a
      >
      <a href="/about" aria-current={current === "about" ? "page" : undefined}
        >About</a
      >
    </nav>
    <main>
      <slot />
    </main>
    <footer>&copy; doitpoorly</footer>
  </body>
</html>
