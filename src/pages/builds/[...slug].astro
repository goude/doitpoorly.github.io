---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("builds");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} current="builds">
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {post.data.date.toLocaleDateString("en-CA")}
      {post.data.draft ? " · draft" : ""}
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    {
      post.data.images.length > 0 && (
        <div class="gallery">
          {post.data.images.map((img) => (
            <Image src={img} alt="" widths={[400, 800, 1200]} sizes="(min-width: 700px) 640px, 100vw" />
          ))}
        </div>
      )
    }
    <Content />
  </article>
</Layout>
